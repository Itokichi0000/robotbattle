# /etc/sats-wars/server.env — game server settings (root:satswars, 0640).
# Secrets live only here. After editing: sudo systemctl restart sats-wars-server
# Full list of variables: .env.example. Rules for production: docs/PRODUCTION_GUIDE.md.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
# Caddy on this host tells us the client IP (rate limits are per phone, not per proxy).
TRUST_PROXY=loopback
DATABASE_PATH=/var/lib/sats-wars/sats-wars.db
BACKUP_DIR=/var/lib/sats-wars/backups
BACKUP_INTERVAL_MINUTES=30
BACKUP_KEEP=48
RETENTION_DAYS=30
LOG_LEVEL=info

# One domain for everything: Caddy sends /api and /socket.io to this server.
SERVER_PUBLIC_URL=https://__DOMAIN__
ALLOWED_ORIGINS=https://__DOMAIN__
PUBLIC_PARTICIPANT_URL=https://__DOMAIN__/play
EVENT_ID=__EVENT_ID__

# Operators. Written once by setup-vps.sh. Named staff accounts: `pnpm admin:user`,
# then ADMIN_USERS=... and ADMIN_SHARED_LOGIN=false.
ADMIN_PASSWORD=__ADMIN_PASSWORD__
# ADMIN_USERS=
# ADMIN_SHARED_LOGIN=false

# Production: guests can always play; the wallet option is real LNURL-auth.
AUTH_MODE=lnurl
DEMO_MODE=false
# A free event until real payments are approved by the owner. PASS_MODE=PAID needs
# PAYMENT_MODE=lnbits + ALLOW_REAL_PAYMENTS=true (the server refuses PAID with mock).
PASS_MODE=FREE
PAYMENT_MODE=mock
ALLOW_REAL_PAYMENTS=false
