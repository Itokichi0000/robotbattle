# /etc/sats-wars/web.env — web app settings (no secrets here).
# NEXT_PUBLIC_* values are baked into the build: run deploy.sh again after changing them.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
# Same domain as the pages: the socket URL and the CSP connect-src come from this.
NEXT_PUBLIC_GAME_SERVER_URL=https://__DOMAIN__
