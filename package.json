{
  "name": "sats-wars",
  "version": "0.1.0",
  "private": true,
  "description": "SATS WARS — 雷神 vs 風神: venue real-time 3D team battle game",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "pnpm --filter @sats-wars/server dev",
    "dev:web": "pnpm --filter @sats-wars/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "start": "node tools/start.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "simulate": "pnpm --filter @sats-wars/simulations simulate",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "solo": "pnpm --filter @sats-wars/solo build",
    "models:build": "blender -b --factory-startup --python-exit-code 1 -P tools/blender/build_robot.py --",
    "models:validate": "blender -b --factory-startup --python-exit-code 1 -P tools/blender/validate_robot.py --",
    "models:test": "pnpm --filter @sats-wars/model-viewer e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
