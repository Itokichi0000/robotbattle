{
  "name": "sats-wars",
  "version": "0.1.0",
  "private": true,
  "description": "SATS WARS: EARTH DEFENSE — co-op venue raid: the crowd pilots RAIJIN and FUJIN against NULL CORE",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "pnpm --filter @sats-wars/server dev",
    "dev:web": "pnpm --filter @sats-wars/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "start": "node tools/start.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "simulate": "pnpm --filter @sats-wars/simulations simulate",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "solo": "pnpm --filter @sats-wars/solo build",
    "admin:user": "node tools/admin-user.mjs",
    "db:backup": "node tools/db-backup.mjs",
    "db:restore": "node tools/db-restore.mjs",
    "security:secrets": "node tools/security/scan-secrets.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
