# SATS WARS: EARTH DEFENSE — copy to .env (never commit .env). Real env vars override this file.
# Everything here is optional for local sandbox play: `pnpm dev` runs with no keys at all.

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=4400

# Public origin phones (and, from Phase 3, wallets) reach. Required and https:// in production.
# Unset in development: the server guesses http://<LAN IP>:PORT for the join QR.
# PUBLIC_BASE_URL=https://sats-wars.example

# sandbox = no real money, DEMO GUEST sign-in. live is refused until Phase 3/4 exist and the
# owner explicitly approves real payments.
APP_MODE=sandbox

# Staff console password. Required (12+ chars) in production. Unset in dev = random per run.
OPERATOR_PASSWORD=

# SQLite file (sessions, matches, action log, audit log). ':memory:' for throwaway runs.
DATABASE_PATH=data/sats-wars.db

# Free DEMO GUEST sign-in. Defaults to on in sandbox, off otherwise.
# DEMO_GUEST_ENABLED=true

# STANDARD (210 s of combat) | SHORT (150 s). TEST is for automated tests and refused in production.
MATCH_PRESET=STANDARD
# Fixed RNG seed for rehearsals (same waves every match). Omit for fresh seeds.
# MATCH_SEED=42

# Behind a reverse proxy (Caddy/nginx) that sets X-Forwarded-*.
TRUST_PROXY=false
# Extra browser origins allowed to call cookie endpoints, comma separated.
ALLOWED_ORIGINS=

# dev (Vite middleware) | static (apps/*/dist) | none. Defaults: dev in development, static in production.
# WEB_MODE=static
LOG_LEVEL=info

# --- Phase 3/4 (not implemented yet; listed so operators know what will be asked) ---
# LNURL-auth uses PUBLIC_BASE_URL as its domain; no key needed.
# Lightning receiving backend (LNbits invoice/read key only — never an admin key):
# LIGHTNING_PROVIDER=lnbits
# LNBITS_URL=
# LNBITS_INVOICE_KEY=
