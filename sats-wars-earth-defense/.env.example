# SATS WARS: EARTH DEFENSE — copy to .env (never commit .env). Real env vars override this file.
# Everything here is optional for local sandbox play: `pnpm dev` runs with no keys at all.

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=4400

# Public origin phones and wallets reach. Required and https:// in production and in live mode.
# It is also the LNURL-auth domain: wallets derive the pilot's linking key from its host.
# Unset in development: the server guesses http://<LAN IP>:PORT for the join QR.
# PUBLIC_BASE_URL=https://sats-wars.example

# sandbox = VIRTUAL energy pulses only (no money moves), DEMO GUEST allowed.
# live    = real Lightning invoices through LNbits. Needs the LNBITS_* settings below and the
#           owner's explicit approval. Even then pulses stay OFF until staff run the checks in
#           /operator and type LIVE (they are never on at start).
APP_MODE=sandbox

# Staff console password. Required (12+ chars) in production. Unset in dev = random per run.
OPERATOR_PASSWORD=

# SQLite file (sessions, matches, action log, audit log). ':memory:' for throwaway runs.
DATABASE_PATH=data/sats-wars.db

# Free DEMO GUEST sign-in. Defaults to on in sandbox, off otherwise.
# DEMO_GUEST_ENABLED=true

# STANDARD (210 s of combat) | SHORT (150 s). TEST is for automated tests and refused in production.
MATCH_PRESET=STANDARD
# Fixed RNG seed for rehearsals (same waves every match). Omit for fresh seeds.
# MATCH_SEED=42

# Behind a reverse proxy (Caddy/nginx) that sets X-Forwarded-*.
TRUST_PROXY=false
# Extra browser origins allowed to call cookie endpoints, comma separated.
ALLOWED_ORIGINS=

# dev (Vite middleware) | static (apps/*/dist) | none. Defaults: dev in development, static in production.
# WEB_MODE=static
LOG_LEVEL=info

# --- Lightning (APP_MODE=live only) ---------------------------------------------------
# LNURL-auth sign-in needs no key: it uses PUBLIC_BASE_URL as its domain.
# Receiving backend: LNbits with the INVOICE/READ key only. Never an admin key: the server
# only creates invoices (out:false) and reads their status; it cannot spend.
# LIGHTNING_PROVIDER=lnbits
# LNBITS_URL=https://lnbits.example
# LNBITS_INVOICE_KEY=
# Shown to every payer before an invoice exists (who receives the sats).
# PAYMENT_RECIPIENT_LABEL=
# Fixed pulse price in sats (default 21). Paying more never makes anyone stronger.
# PULSE_AMOUNT_SATS=21
# Token in the webhook URL given to LNbits (random per run if unset). The webhook is only a
# hint: the server always re-checks the payment with LNbits before applying it.
# LNBITS_WEBHOOK_SECRET=
