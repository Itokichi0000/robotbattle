    "@fastify/static": "^8.3.0",
    "@noble/curves": "~2.3.0",
    "@noble/hashes": "~2.3.0",
    "@scure/base": "~2.0.0",
    "@swed/game-engine": "workspace:*",
    "@swed/shared": "workspace:*",
    "fastify": "^5.6.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.25.11",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "^4.1.12"
  }
