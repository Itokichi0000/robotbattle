{
  "name": "@swed/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude '**/node_modules/**' src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
