{
  "name": "@sats-wars/solo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline single-player demo: engine, bots and 3D arena in one self-contained HTML file",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "~10.7.6",
    "@react-three/fiber": "~9.4.0",
    "@sats-wars/game-engine": "workspace:*",
    "@sats-wars/shared": "workspace:*",
    "@sats-wars/three-game": "workspace:*",
    "@sats-wars/ui": "workspace:*",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "~0.181.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "~0.181.0",
    "esbuild": "^0.25.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
