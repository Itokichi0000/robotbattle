# SATS WARS: EARTH DEFENSE — example environment. Copy to .env and edit. NEVER commit .env.
# Values here are dummies; real keys live only on the server host. See docs/EVENT_RUNBOOK.md.

# ---- Game server -----------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_PATH=./data/sats-wars-raid.db
# Required in production. In development a one-time password is generated and printed if empty.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Named operator accounts (recommended for events): "name:role:scrypt-hash[:totp-base32]" joined by ";".
# Roles: viewer (read) / operator (run the event) / owner (money and rules). Create entries with `pnpm admin:user`.
# ADMIN_USERS=
# Turn the shared ADMIN_PASSWORD login off once named accounts exist.
# ADMIN_SHARED_LOGIN=true
# Optional TOTP (base32) required together with the shared password.
# ADMIN_TOTP_SECRET=
# Comma-separated browser origins allowed to call the API (required in production; empty = localhost/LAN in dev).
ALLOWED_ORIGINS=http://localhost:3000
# URL encoded in the venue QR code (must be the real, verified event URL).
PUBLIC_PARTICIPANT_URL=http://localhost:3000/play
# Public https URL of this game server (LNURL-auth callback and LNbits webhooks need it).
SERVER_PUBLIC_URL=
EVENT_ID=local-demo
LOG_LEVEL=info
# Guest sign-ups per minute per IP (venue Wi-Fi often puts everyone behind one IP).
GUEST_SIGNUPS_PER_MINUTE=300
# Who may set X-Forwarded-For (client IP for rate limits): loopback = a proxy on this host (Caddy).
TRUST_PROXY=loopback
# Secure cookies (defaults to true in production).
# COOKIE_SECURE=true

# ---- Modes -----------------------------------------------------------------
# DEMO_MODE: free passes, mock login allowed, demo bots and time scale, labelled DEMO everywhere.
DEMO_MODE=false
# mock = guest + test wallet (dev/demo) / lnurl = real LNURL-auth only (required in production) / both
AUTH_MODE=mock
# FREE = free event (no payment) / PAID = 21-sat raid pass. Default: FREE in DEMO_MODE, PAID otherwise.
# PASS_MODE=PAID
# Optional overrides of GameConfig for new raids.
# TICKET_PRICE_SATS=21
# RAID_SECONDS=480

# ---- Demo helpers (rehearsals / unattended demos; clearly labelled BOT, never pay) ----
DEMO_BOTS=0
DEMO_BOT_SKILL=0.65
# Shortcut: 6 bots when DEMO_BOTS is 0.
DEMO_AUTOPILOT=false

# ---- Data ---------------------------------------------------------------------
# Database copies (SQLite VACUUM INTO) after each raid, every N minutes and on demand. Default: ./data/backups.
# BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=30
BACKUP_KEEP=48
# Expired sessions are deleted this many days after they expired.
RETENTION_DAYS=30
# Optional: link a Nostr key to the license card (display only, never a login). Off by default.
NOSTR_LINK=false

# ---- Payments ----------------------------------------------------------------
# mock   = fake invoices, no real sats (default, safe)
# lnbits = REAL Lightning payments. Requires owner approval: see docs/EVENT_RUNBOOK.md "実決済（承認後）"
PAYMENT_MODE=mock
# LNbits wallet INVOICE/READ key only. Never the admin key (this app never sends funds).
LNBITS_URL=https://lnbits.example.com
LNBITS_INVOICE_KEY=
# Random string; becomes part of the webhook path.
LNBITS_WEBHOOK_SECRET=
# Must be set to true explicitly before PAYMENT_MODE=lnbits will start.
ALLOW_REAL_PAYMENTS=false
PAYEE_DESCRIPTION=SATS WARS 出撃パス / SATS WARS raid pass

# ---- Web (Next.js) -------------------------------------------------------------
# Defaults to http(s)://<same host>:4000 when unset (works on a venue LAN).
# NEXT_PUBLIC_GAME_SERVER_URL=https://api.game.example.com
