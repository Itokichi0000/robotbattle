# SATS WARS — example environment. Copy to .env and edit. NEVER commit .env.
# Values here are dummies; real keys live only on the server host.

# ---- Game server -----------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_PATH=./data/sats-wars.db
# Required in production. In development a one-time password is generated and printed if empty.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Comma-separated browser origins allowed to call the API (required in production).
ALLOWED_ORIGINS=http://localhost:3000
# URL encoded in the venue QR code (must be the real, verified event URL).
PUBLIC_PLAY_URL=http://localhost:3000/play
LOG_LEVEL=info

# ---- Demo helpers -----------------------------------------------------------
# Shorter lobby for local demos (ms). Default 30000.
# LOBBY_MS=15000
# Bots per team (clearly labelled BOT). 0 = off.
DEMO_BOTS_PER_TEAM=0
# Unattended loop: open lobby, bots, next match automatically.
DEMO_AUTOPILOT=false

# ---- Payments ----------------------------------------------------------------
# mock   = fake invoices, no real sats (default, safe)
# lnbits = REAL Lightning payments. Requires owner approval: see docs/PAYMENT_FLOW.md
PAYMENT_MODE=mock
# LNbits wallet INVOICE/READ key only. Never the admin key (this app never sends funds).
LNBITS_URL=https://lnbits.example.com
LNBITS_INVOICE_KEY=
# Random string; becomes part of the webhook path.
LNBITS_WEBHOOK_SECRET=
# Public URL of this game server reachable by LNbits (for webhooks).
SERVER_PUBLIC_URL=
# Must be set to true explicitly before PAYMENT_MODE=lnbits will start.
ALLOW_REAL_PAYMENTS=false

# ---- Web (Next.js) -------------------------------------------------------------
# Defaults to http(s)://<same host>:4000 when unset (works on a venue LAN).
# NEXT_PUBLIC_GAME_SERVER_URL=https://game.example.com
